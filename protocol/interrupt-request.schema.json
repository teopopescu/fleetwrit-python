{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fleetwrit.dev/schema/v1/interrupt-request.schema.json",
  "title": "Fleetwrit interrupt request",
  "description": "The request an agent emits to pause for a human decision.",
  "type": "object",
  "required": [
    "schema",
    "kind",
    "agent",
    "action",
    "fingerprint",
    "summary",
    "idempotency_key",
    "created_at",
    "expires_at",
    "on_expiry"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "type": "string",
      "const": "fleetwrit/v1"
    },
    "id": {
      "type": "string",
      "description": "Server-assigned request id."
    },
    "kind": {
      "type": "string",
      "enum": ["approve", "input", "choose"]
    },
    "agent": {
      "type": "object",
      "required": ["id", "environment"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "environment": { "type": "string" },
        "version": { "type": ["string", "null"] }
      }
    },
    "action": {
      "type": "object",
      "required": ["type", "version", "args", "reversible"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string" },
        "version": { "type": "string" },
        "tool": { "type": ["string", "null"] },
        "args": { "type": "object" },
        "reversible": { "type": "boolean" }
      }
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "summary": { "type": "string" },
    "context": { "type": "object" },
    "queue": { "type": ["string", "null"] },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "run_id": { "type": ["string", "null"] },
        "parent_request_id": { "type": ["string", "null"] },
        "trace_id": { "type": ["string", "null"] }
      }
    },
    "idempotency_key": { "type": "string" },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "on_expiry": {
      "type": "string",
      "enum": ["reject", "raise"]
    }
  }
}
